# Local Supabase OAuth — kopyala proje köküne: `.env`
# (Supabase CLI `env(...)` değerlerini kök `.env` dosyasından okur)
# İstersen aynı satırları `supabase/.env` içine de koyabilirsin.
# Sonra: supabase stop && supabase start
#
# Google Cloud Console → Credentials → OAuth 2.0 Client (Web):
#   Authorized JavaScript origins:
#     http://127.0.0.1:3000
#     http://localhost:3000
#   Authorized redirect URIs:
#     http://127.0.0.1:54321/auth/v1/callback
#
# GitHub → Settings → Developer settings → OAuth Apps → New:
#   Homepage URL: http://127.0.0.1:3000
#   Authorization callback URL:
#     http://127.0.0.1:54321/auth/v1/callback

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
